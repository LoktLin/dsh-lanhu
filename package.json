{
  "name": "dsh-lanhu",
  "version": "0.5.3",
  "description": "让 AI 直接「读蓝湖（Lanhu）设计稿」—— 把设计稿解析成可直抄的精确数值（色值 / 字号 / 圆角 / 间距 / 文本），替代靠截图估算。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./lanhu": {
      "default": "./lanhu.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "lanhu": "./lanhu.mjs"
  },
  "files": [
    "lib",
    "lanhu.mjs",
    "cordis.patch.yml",
    "docs",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "lanhu",
    "design",
    "design-to-code",
    "design-spec"
  ],
  "author": "LoktLin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LoktLin/dsh-lanhu.git"
  },
  "homepage": "https://github.com/LoktLin/dsh-lanhu#readme",
  "bugs": {
    "url": "https://github.com/LoktLin/dsh-lanhu/issues"
  },
  "license": "MIT",
  "optionalDependencies": {
    "puppeteer-core": "^25.11.0"
  }
}
